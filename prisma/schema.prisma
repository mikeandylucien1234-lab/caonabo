// ─────────────────────────────────────────────────────────────────────────────
// Caonabo Airlinje — schéma de base de données
//
// PRODUCTION (défaut) : provider = "postgresql" (Supabase "caonabo").
//   DATABASE_URL = connexion poolée (pgBouncer, port 6543) — API serverless Vercel
//   DIRECT_URL   = connexion directe (port 5432) — migrations Prisma
//
// DEV LOCAL sans Postgres : pour repasser sur SQLite, remplacer provider par
//   "sqlite", retirer la ligne directUrl, et mettre DATABASE_URL="file:./dev.db".
//   Le schéma évite enums et types Postgres-spécifiques : la bascule est triviale.
//
// Devise : tous les prix sont stockés en USD, en entiers (cents) => aucun
// flottant en base. L'affichage dans une autre devise (CLP, CAD, PEN) se fait
// par conversion via la table ExchangeRate.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // connexion poolée (pgBouncer, port 6543) en prod
  directUrl = env("DIRECT_URL") // connexion directe (port 5432) pour les migrations
}

// Aéroports / villes desservis
model Airport {
  id          String   @id @default(cuid())
  code        String   @unique // IATA, ex: SCL, PAP, CAP, YYZ, YUL, LIM
  city        String
  country     String
  description String   @default("") // texte affiché sur la page "Nos Destinations"
  imageUrl    String   @default("") // visuel de la carte destination (optionnel)
  createdAt   DateTime @default(now())

  routesFrom Route[] @relation("RouteOrigin")
  routesTo   Route[] @relation("RouteDestination")

  @@index([country])
}

// Liaison origine → destination
model Route {
  id            String  @id @default(cuid())
  originId      String
  destinationId String
  directFlight  Boolean @default(true)
  stops         Int     @default(0)

  origin      Airport @relation("RouteOrigin", fields: [originId], references: [id])
  destination Airport @relation("RouteDestination", fields: [destinationId], references: [id])

  flights Flight[]

  @@unique([originId, destinationId])
}

// Vols concrets (recherchables / réservables)
model Flight {
  id             String   @id @default(cuid())
  flightNumber   String   @unique
  routeId        String
  departAt       DateTime
  arriveAt       DateTime
  priceUsdCents  Int // prix de référence en USD (cents)
  seatsTotal     Int      @default(150) // Boeing 737-400 : 12 Première + 138 Économique
  seatsAvailable Int      @default(150)
  operatedBy      String  @default("Caonabo Airlinje")
  durationMinutes Int     @default(0) // durée totale du trajet
  stopsCount      Int     @default(0) // nombre d'escales
  stopAirports    String  @default("") // codes IATA des escales, séparés par ","
  createdAt      DateTime @default(now())

  route    Route     @relation(fields: [routeId], references: [id])
  bookings Booking[]
  seats    Seat[]

  @@index([routeId, departAt])
}

// Destinations phares affichées sur la home (bloc "Destinations populaires")
model Destination {
  id              String   @id @default(cuid())
  slug            String   @unique
  city            String
  country         String
  priceUsdCents   Int
  discountPct     Int      @default(0)
  imageUrl        String
  placeholder     String   @default("") // description texte d'origine du proto
  originCode      String   @default("SCL") // IATA origine de la route reliée
  destinationCode String   @default("PAP") // IATA destination de la route reliée
  featured        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())

  @@index([featured, sortOrder])
}

// Promotions (bloc "Promotions Caonabo")
model Promotion {
  id               String    @id @default(cuid())
  slug             String    @unique
  title            String
  routeLabel       String // ex: "Cap-Haïtien → Labadee"
  category         String // ex: "DIASPORA"
  categoryColor    String    @default("#8a8aa0")
  tag              String // ex: "PLAGE PARADIS"
  tagColor         String    @default("#3d1e8a")
  accentColor      String    @default("#5b21b6") // couleur prix + bouton
  priceUsdCents    Int
  oldPriceUsdCents Int
  imageUrl         String
  placeholder      String    @default("")
  originCode       String    @default("SCL") // IATA origine de la route reliée
  destinationCode  String    @default("CAP") // IATA destination de la route reliée
  validUntil       DateTime?
  sortOrder        Int       @default(0)
  createdAt        DateTime  @default(now())

  @@index([sortOrder])
}

// FAQ (accordéon)
model Faq {
  id        String @id @default(cuid())
  question  String
  answer    String
  sortOrder Int    @default(0)

  @@index([sortOrder])
}

// Étapes "Préparez-vous à voyager"
model PrepStep {
  id          String @id @default(cuid())
  icon        String
  title       String
  description String
  sortOrder   Int    @default(0)

  @@index([sortOrder])
}

// Taux de change (USD = devise pivot)
model ExchangeRate {
  id         String   @id @default(cuid())
  currency   String   @unique // "USD", "CLP", "CAD", "PEN"
  symbol     String // "$", "CLP", "CA$", "S/"
  ratePerUsd Float // 1 USD = ratePerUsd <currency>
  updatedAt  DateTime @updatedAt
}

// Comptes clients (optionnels : la réservation invité par référence reste possible)
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  milesBalance Int      @default(0) // Miles Caonabo utilisables au paiement (1 Mile = 0,01 USD)
  createdAt    DateTime @default(now())

  bookings Booking[]

  @@index([email])
}

// Réservations
model Booking {
  id             String   @id @default(cuid())
  reference      String   @unique // PNR court alphanumérique
  flightId       String
  userId         String? // null = réservation invité (par référence)
  tripType       String   @default("aller-retour") // aller-retour | aller-simple
  cabinClass     String   @default("Économique") // Économique | Première classe
  contactEmail   String
  contactPhone   String?
  passengerCount Int      @default(1)
  // Ventilation complète des coûts (en cents USD)
  basePriceCents    Int   @default(0) // vol × passagers
  baggageTotalCents Int   @default(0)
  seatTotalCents    Int   @default(0)
  taxesCents        Int   @default(0)
  milesRedeemed     Int   @default(0) // Miles utilisés (1 Mile = 1 cent de remise)
  totalUsdCents     Int // montant réellement payé (net)
  currency          String @default("USD")
  milesEarned       Int    @default(0) // Miles crédités par cette réservation
  paymentMethodDisplay String? // moyen de paiement (ex: retourné par Flow, ou démo)
  // ── Paiement Flow (flow.cl) — distinct du statut de réservation ────────────
  // status  = la réservation est-elle validée (pending | confirmed | cancelled)
  // payment = la réservation est-elle payée (PENDING | PAID | FAILED | EXPIRED)
  paymentStatus    String    @default("PENDING")
  flowPaymentToken String? // identifiant du paiement côté Flow
  flowPaymentUrl   String? // URL de paiement Flow générée
  paidAt           DateTime? // horodatage de confirmation du paiement (webhook)
  receiptUrl       String? // chemin du comprobante PDF (Supabase Storage)
  receiptNumber    String?   @unique // numéro lisible, ex: CAO-2026-000123
  status         String   @default("pending") // pending | confirmed | cancelled
  createdAt      DateTime @default(now())

  flight     Flight      @relation(fields: [flightId], references: [id])
  user       User?       @relation(fields: [userId], references: [id])
  passengers Passenger[]

  @@index([reference])
  @@index([userId])
}

// Politique de bagages (Boeing 737-400, affrètement complet).
// Table de CONFIGURATION à une seule ligne = source de vérité des franchises
// incluses et des tarifs de supplément. Éditable sans redéploiement.
//   Inclus / passager : 1 bagage soute (max 23 kg) + 1 bagage cabine (max 8 kg)
//   Supplément poids   : 5 USD par kg au-delà de la franchise soute
//   Valise entière sup.: 68 USD (forfait par bagage supplémentaire)
model BaggagePolicy {
  id                 String   @id @default(cuid())
  includedCheckedKg  Int      @default(23) // 1 bagage soute inclus (max 23 kg)
  includedCabinKg    Int      @default(8) // 1 bagage cabine inclus (max 8 kg)
  extraKgPriceCents  Int      @default(500) // 5 USD / kg supplémentaire
  extraBagPriceCents Int      @default(6800) // 68 USD / valise entière supplémentaire
  updatedAt          DateTime @updatedAt
}

// Sièges d'un vol (matérialisés à la demande)
model Seat {
  id                 String  @id @default(cuid())
  flightId           String
  row                Int
  column             String // A..F
  type               String  @default("STANDARD") // STANDARD | WINDOW | AISLE
  fareClass          String  @default("Économique") // Économique | Première classe
  priceSupplementCents Int   @default(0)
  isAvailable        Boolean @default(true)
  // Verrou temporaire « en cours de sélection » : un siège tenu par un tunnel
  // n'est plus proposable aux autres jusqu'à heldUntil (auto-libéré à expiration).
  heldUntil          DateTime? // null = pas de réservation temporaire en cours
  heldBy             String? // jeton opaque du tunnel qui détient le siège

  flight     Flight      @relation(fields: [flightId], references: [id], onDelete: Cascade)
  passengers Passenger[]

  @@unique([flightId, row, column])
  @@index([flightId])
}

// Passagers rattachés à une réservation (avec documents + siège + bagage)
model Passenger {
  id         String    @id @default(cuid())
  bookingId  String
  civility   String    @default("M") // M | MME | MLLE
  firstName  String
  lastName   String
  type       String    @default("adult") // adult | child | infant
  birthDate  DateTime?
  nationality String?
  // Document d'identité
  documentType           String? // PASSPORT | ID_CARD
  documentNumber         String?
  documentExpiry         DateTime?
  documentIssuingCountry String?
  phone                  String?
  // Visa électronique (optionnel) — chemin de l'objet dans le bucket privé
  // "passenger-documents" (document personnel sensible, accès restreint admin).
  evisaFileUrl           String?
  // Choix optionnels
  seatId          String?
  // Bagages : la franchise (1 soute 23 kg + 1 cabine 8 kg) est incluse pour
  // tous. On ne stocke que les SUPPLÉMENTS choisis par le passager.
  extraBaggageKg  Int    @default(0) // kg au-delà de la franchise soute (5 USD/kg)
  extraFullBags   Int    @default(0) // valises entières supplémentaires (68 USD pièce)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  seat    Seat?   @relation(fields: [seatId], references: [id])

  @@index([bookingId])
}

// Messages reçus via le formulaire "Contactez-nous"
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String // Réservation | Réclamation | Presse | Autre
  message   String
  isRead    Boolean  @default(false) // statut lu / non-lu
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Demandes de devis pour un voyage de groupe
model GroupRequest {
  id          String   @id @default(cuid())
  travelers   Int // nombre de voyageurs
  route       String // route souhaitée (ex: "Santiago → Port-au-Prince")
  approxDates String? // dates approximatives (texte libre)
  email       String
  phone       String?
  status      String   @default("new") // new | processing | done
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

// Médias des sections « bannière » du site public (Hero, cartes vidéo
// Toronto/Port-au-Prince, bannière avant « Préparez-vous »). L'admin peut
// remplacer chaque média (vidéo mp4 ou image) sans redéploiement : le média
// est stocké dans Supabase Storage (bucket public) et l'URL + le type sont
// enregistrés ici. Le composant public affiche <video> ou <img> selon le type.
// Une clé absente ⇒ le composant garde son média par défaut (fichier /public).
model SiteMedia {
  id            String   @id @default(cuid())
  key           String   @unique // hero | dest-toronto | dest-pap | video-banner
  mediaType     String   @default("image") // "image" | "video"
  url           String // URL publique du média (Supabase Storage)
  fileSizeBytes Int      @default(0)
  updatedAt     DateTime @updatedAt
}

// Configuration du prestataire de paiement Flow (flow.cl).
// Table SINGLETON (une seule ligne). Les clés API/Secret sont stockées
// CHIFFRÉES (AES-256-GCM, clé dans CREDENTIALS_ENCRYPTION_KEY côté serveur) et
// ne sont jamais renvoyées au frontend, même chiffrées. Entièrement pilotable
// depuis l'admin, sans redéploiement.
model PaymentSettings {
  id                 String    @id @default(cuid())
  apiKeyEncrypted    String? // clé API Flow, chiffrée
  secretKeyEncrypted String? // clé secrète Flow, chiffrée
  mode               String    @default("SANDBOX") // SANDBOX | PRODUCTION
  isConfigured       Boolean   @default(false) // vrai dès que les 2 clés sont posées
  lastTestedAt       DateTime?
  lastTestResult     String? // SUCCESS | FAILURE
  updatedAt          DateTime  @updatedAt
}

// Abonnés à la newsletter (section « Ne manquez jamais une offre »)
model NewsletterSubscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  consentGiven Boolean  @default(true)
  subscribedAt DateTime @default(now())

  @@index([subscribedAt])
}
