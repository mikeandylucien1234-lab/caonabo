# ─────────────────────────────────────────────────────────────
# Caonabo Airlinje — variables d'environnement
# ─────────────────────────────────────────────────────────────

# PRODUCTION (PostgreSQL — projet Supabase "caonabo", ref xfdugmfqyphmjdbghlow)
# Récupérer les chaînes exactes dans Supabase → bouton "Connect".
#
# DATABASE_URL = connexion POOLÉE (pgBouncer, port 6543) — API serverless Vercel.
#                Ajouter ?pgbouncer=true.
# DIRECT_URL   = connexion DIRECTE (port 5432) — migrations Prisma.
DATABASE_URL="postgresql://postgres.xfdugmfqyphmjdbghlow:[MOT_DE_PASSE]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xfdugmfqyphmjdbghlow:[MOT_DE_PASSE]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# Secret de session (auth). Générer une valeur aléatoire ≥ 32 caractères :
#   openssl rand -base64 32
AUTH_SECRET="a-remplacer-par-une-valeur-aleatoire-longue"

# URL publique du site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─────────────────────────────────────────────────────────────
# DEV LOCAL sans Postgres (optionnel) : SQLite.
#   1. Dans prisma/schema.prisma : provider = "sqlite", retirer la ligne directUrl
#   2. DATABASE_URL="file:./dev.db"  (et commenter DIRECT_URL)
#   3. npx prisma db push && npm run db:seed
# ─────────────────────────────────────────────────────────────

# ── Back-office admin (Supabase Auth + RLS) ──────────────────────────────────
# Clés PUBLIQUES (sans danger à exposer côté client). À ajouter aussi dans Vercel.
NEXT_PUBLIC_SUPABASE_URL=https://xfdugmfqyphmjdbghlow.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9....(clé anon)
