# ─────────────────────────────────────────────────────────────
# Caonabo Airlinje — variables d'environnement
# ─────────────────────────────────────────────────────────────

# DÉVELOPPEMENT LOCAL (SQLite) — laisser tel quel pour dev rapide.
#   1. Dans prisma/schema.prisma, mettre provider = "sqlite"
#   2. DATABASE_URL="file:./dev.db"
DATABASE_URL="file:./dev.db"

# PRODUCTION (PostgreSQL — projet Supabase "caonabo")
# Récupérer ces valeurs dans Supabase → Project Settings → Database.
#
# DATABASE_URL = connexion POOLÉE (pgBouncer, port 6543) — utilisée par les
#                API routes serverless de Vercel. Ajouter ?pgbouncer=true.
# DIRECT_URL   = connexion DIRECTE (port 5432) — utilisée par les migrations Prisma.
#
# DATABASE_URL="postgresql://postgres.xfdugmfqyphmjdbghlow:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.xfdugmfqyphmjdbghlow:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# URL publique du site (utilisée pour les métadonnées / liens absolus)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
