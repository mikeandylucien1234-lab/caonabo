// ─────────────────────────────────────────────────────────────────────────────
// Caonabo Airlinje — schéma de base de données
//
// PRODUCTION (défaut) : provider = "postgresql" (Supabase "caonabo").
//   DATABASE_URL = connexion poolée (pgBouncer, port 6543) — API serverless Vercel
//   DIRECT_URL   = connexion directe (port 5432) — migrations Prisma
//
// DEV LOCAL sans Postgres : pour repasser sur SQLite, remplacer provider par
//   "sqlite", retirer la ligne directUrl, et mettre DATABASE_URL="file:./dev.db".
//   Le schéma évite enums et types Postgres-spécifiques : la bascule est triviale.
//
// Devise : tous les prix sont stockés en USD, en entiers (cents) => aucun
// flottant en base. L'affichage dans une autre devise (CLP, CAD, PEN) se fait
// par conversion via la table ExchangeRate.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // connexion poolée (pgBouncer, port 6543) en prod
  directUrl = env("DIRECT_URL") // connexion directe (port 5432) pour les migrations
}

// Aéroports / villes desservis
model Airport {
  id        String   @id @default(cuid())
  code      String   @unique // IATA, ex: SCL, PAP, CAP, YYZ, YUL, LIM
  city      String
  country   String
  createdAt DateTime @default(now())

  routesFrom Route[] @relation("RouteOrigin")
  routesTo   Route[] @relation("RouteDestination")

  @@index([country])
}

// Liaison origine → destination
model Route {
  id            String  @id @default(cuid())
  originId      String
  destinationId String
  directFlight  Boolean @default(true)
  stops         Int     @default(0)

  origin      Airport @relation("RouteOrigin", fields: [originId], references: [id])
  destination Airport @relation("RouteDestination", fields: [destinationId], references: [id])

  flights Flight[]

  @@unique([originId, destinationId])
}

// Vols concrets (recherchables / réservables)
model Flight {
  id             String   @id @default(cuid())
  flightNumber   String   @unique
  routeId        String
  departAt       DateTime
  arriveAt       DateTime
  priceUsdCents  Int // prix de référence en USD (cents)
  seatsTotal     Int      @default(180)
  seatsAvailable Int      @default(180)
  createdAt      DateTime @default(now())

  route    Route     @relation(fields: [routeId], references: [id])
  bookings Booking[]

  @@index([routeId, departAt])
}

// Destinations phares affichées sur la home (bloc "Destinations populaires")
model Destination {
  id              String   @id @default(cuid())
  slug            String   @unique
  city            String
  country         String
  priceUsdCents   Int
  discountPct     Int      @default(0)
  imageUrl        String
  placeholder     String   @default("") // description texte d'origine du proto
  originCode      String   @default("SCL") // IATA origine de la route reliée
  destinationCode String   @default("PAP") // IATA destination de la route reliée
  featured        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())

  @@index([featured, sortOrder])
}

// Promotions (bloc "Promotions Caonabo")
model Promotion {
  id               String    @id @default(cuid())
  slug             String    @unique
  title            String
  routeLabel       String // ex: "Cap-Haïtien → Labadee"
  category         String // ex: "DIASPORA"
  categoryColor    String    @default("#8a8aa0")
  tag              String // ex: "PLAGE PARADIS"
  tagColor         String    @default("#3d1e8a")
  accentColor      String    @default("#5b21b6") // couleur prix + bouton
  priceUsdCents    Int
  oldPriceUsdCents Int
  imageUrl         String
  placeholder      String    @default("")
  originCode       String    @default("SCL") // IATA origine de la route reliée
  destinationCode  String    @default("CAP") // IATA destination de la route reliée
  validUntil       DateTime?
  sortOrder        Int       @default(0)
  createdAt        DateTime  @default(now())

  @@index([sortOrder])
}

// FAQ (accordéon)
model Faq {
  id        String @id @default(cuid())
  question  String
  answer    String
  sortOrder Int    @default(0)

  @@index([sortOrder])
}

// Étapes "Préparez-vous à voyager"
model PrepStep {
  id          String @id @default(cuid())
  icon        String
  title       String
  description String
  sortOrder   Int    @default(0)

  @@index([sortOrder])
}

// Taux de change (USD = devise pivot)
model ExchangeRate {
  id         String   @id @default(cuid())
  currency   String   @unique // "USD", "CLP", "CAD", "PEN"
  symbol     String // "$", "CLP", "CA$", "S/"
  ratePerUsd Float // 1 USD = ratePerUsd <currency>
  updatedAt  DateTime @updatedAt
}

// Comptes clients (optionnels : la réservation invité par référence reste possible)
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  milesBalance Int      @default(0) // Miles Caonabo utilisables au paiement (1 Mile = 0,01 USD)
  createdAt    DateTime @default(now())

  bookings Booking[]

  @@index([email])
}

// Réservations
model Booking {
  id            String   @id @default(cuid())
  reference     String   @unique // ex: CAO-7X4K2
  flightId      String
  userId        String? // null = réservation invité (par référence)
  tripType      String   @default("aller-retour") // aller-retour | aller-simple | multi-destination
  contactEmail  String
  contactPhone  String?
  passengerCount Int     @default(1)
  totalUsdCents Int // montant réellement payé (après déduction des Miles)
  currency      String   @default("USD")
  milesEarned   Int      @default(0) // Miles crédités par cette réservation
  milesRedeemed Int      @default(0) // Miles utilisés pour payer cette réservation
  status        String   @default("pending") // pending | confirmed | cancelled
  createdAt     DateTime @default(now())

  flight     Flight      @relation(fields: [flightId], references: [id])
  user       User?       @relation(fields: [userId], references: [id])
  passengers Passenger[]

  @@index([reference])
  @@index([userId])
}

// Passagers rattachés à une réservation
model Passenger {
  id         String   @id @default(cuid())
  bookingId  String
  firstName  String
  lastName   String
  type       String   @default("adult") // adult | child | infant
  birthDate  DateTime?
  passportNo String?

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}
